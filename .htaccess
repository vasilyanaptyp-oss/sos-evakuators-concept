DirectoryIndex index.html
Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.autopalidziba\.lv$ [NC]
RewriteRule ^ https://autopalidziba.lv%{REQUEST_URI} [L,R=301]

# Old site URLs (before the September 2026 relaunch) still live in Google, ads and bookmarks.
RewriteRule ^lv/autoevakuators-daugavpils/?$ /autoevakuators/ [L,R=301]
RewriteRule ^lv/kravas-evakuators-daugavpils/?$ /kravas-evakuators/ [L,R=301]
RewriteRule ^lv(/.*)?$ / [L,R=301]
RewriteRule ^ru/avtoevakuator-daugavpils/?$ /ru/avtoevakuator/ [L,R=301]
RewriteRule ^ru/gruzovoj-evakuator-daugavpils/?$ /ru/gruzovoj-evakuator/ [L,R=301]
RewriteRule ^ru/(uslugi-avtoservisa|uslugi-gruzovogo-avtoservisa|svarochnye-raboty-avto|konfidencialnost)/?$ /ru/ [L,R=301]
RewriteRule ^en/(towing-service-daugavpils|tow-truck-service)/?$ /en/tow-truck/ [L,R=301]
RewriteRule ^en/(truck-service|autoservice|auto-welding-works|Privacy-policy)/?$ /en/ [L,R=301,NC]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
